{{!< default}}

<article id="post-article" class="post-article">
    <header id="post-header" class="post-header">
        <h1 id="post-title" class="post-page-title">{{title}}</h1>
        <time id="post-published" class="post-published">{{date published_at format="MMM DD, YYYY"}}</time>
    </header>

    {{#if feature_image}}
    <figure id="post-feature-image" class="post-feature-image">
        <img src="{{feature_image}}" alt="{{title}}">
    </figure>
    {{/if}}

    <section id="post-content" class="post-content">
        {{{content}}}
    </section>
</article>
