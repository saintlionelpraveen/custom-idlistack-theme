{{!< default}}

{{!-- Inject Post-Specific CSS --}}
{{#contentFor "styles"}}
  <link rel="stylesheet" href="{{asset "css/post-page.css"}}">
{{/contentFor}}

{{!-- Wrap the entire post in the 'post' context --}}
{{#post}}

{{!-- Progress bar outside the main card --}}
<div class="progress-bar-container">
  <div class="progress-bar" id="progressBar"></div>
</div>

{{!-- The main white card --}}
<article class="post-card-wrapper">
  
  {{!-- Header: Image on left, Title on right center --}}
  <header class="post-page-header">
    
    {{!-- Logo/Image Column --}}
    <div class="post-layout-logo">
      {{#if feature_image}}
        <img class="post-page-logo" src="{{feature_image}}" alt="{{title}}">
      {{else}}
        <div class="post-page-logo-placeholder"></div>
      {{/if}}
    </div>
    
    {{!-- Title Column (centered vertically) --}}
    <div class="post-title-wrapper">
      <h1 class="post-page-title">{{title}}</h1>
    </div>
    
  </header>
  
  {{!-- Content Section (Full Width, Left Aligned) --}}
  <section class="post-page-content">
    {{{content}}}
  </section>

</article>

{{/post}}

{{!-- Inject Post-Specific JS --}}
{{#contentFor "scripts"}}
  <script src="{{asset "js/post.js"}}"></script>
{{/contentFor}}