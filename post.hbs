{{!< default}}

{{#post}}
<article class="post-article post-page" itemscope itemtype="https://schema.org/Article">
  <div class="post-layout" id="post-layout">

    <!-- LEFT COLUMN: Image, Title, and Blocks 1 & 2 -->
    <aside class="post-left" id="post-left">
      {{#if feature_image}}
        <figure class="post-media">
          <img
            class="post-image"
            src="{{img_url feature_image}}"
            srcset="{{img_url feature_image size="s"}} 300w,
                    {{img_url feature_image size="m"}} 600w,
                    {{img_url feature_image size="l"}} 1000w,
                    {{img_url feature_image size="xl"}} 2000w"
            sizes="(max-width: 960px) 100vw, 40vw"
            alt="{{title}}"
            loading="lazy"
          >
        </figure>
      {{/if}}

      <h1 class="post-title" itemprop="headline">{{title}}</h1>

      <!-- Slots for admin content blocks 1 & 2 -->
      <div class="left-extra" id="left-extra" aria-label="Left column extra content"></div>
    </aside>

    <!-- RIGHT COLUMN: Blocks 3 & 4 (CTA) -->
    <section class="post-right" id="post-right">
      <div class="right-content" id="right-content" aria-label="Main post content"></div>
      <div class="right-cta" id="right-cta" aria-label="Post call to action"></div>
    </section>
  </div>

  {{!-- Raw post HTML goes here; JS will distribute into slots --}}
  <div id="ghost-raw-content" class="ghost-raw-content" hidden>
    {{content}}
  </div>
</article>
{{/post}}

<link rel="stylesheet" href="{{asset "css/post-page.css"}}">
<script defer src="{{asset "js/post-page.js"}}"></script>
