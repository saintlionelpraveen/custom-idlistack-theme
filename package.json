{
  "name": "modern-ghost-theme",
  "version": "1.0.0",
  "description": "A modern, beautiful Ghost theme with advanced UI/UX features",
  "engines": {
    "ghost": ">=5.0.0"
  },
  "author": {
    "name": "Modern Ghost Theme",
    "email": "support@modernghost.com",
    "url": "https://modernghost.com"
  },
  "license": "MIT",
  "keywords": [
    "ghost",
    "theme",
    "ghost-theme",
    "responsive",
    "modern",
    "blog"
  ],
  "config": {
    "posts_per_page": 9,
    "image_sizes": {
      "xxs": {
        "width": 30
      },
      "xs": {
        "width": 100
      },
      "s": {
        "width": 300
      },
      "m": {
        "width": 600
      },
      "l": {
        "width": 1000
      },
      "xl": {
        "width": 2000
      }
    }
  },
  "scripts": {
    "dev": "gulp",
    "zip": "gulp zip",
    "test": "gscan ."
  }
}