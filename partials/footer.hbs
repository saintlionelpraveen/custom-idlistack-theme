{{!-- partials/footer.hbs --}}
<footer class="site-footer" role="contentinfo">
  <div class="footer-container">

    {{!-- Brand Section --}}
    <div class="footer-section footer-brand">
      <a href="{{@site.url}}" class="site-logo" aria-label="{{@site.title}} Home">
        {{#if @custom.footer_logo}}
        <img src="{{@custom.footer_logo}}" alt="{{@site.title}}" class="footer-logo" loading="lazy" />
        {{else if @site.logo}}
        <img src="{{@site.logo}}" alt="{{@site.title}}" class="footer-logo" loading="lazy" />
        {{else}}
        <span
          style="font-size: 1.5rem; font-weight: 800; color: #ffffff; letter-spacing: -0.02em;">{{@site.title}}</span>
        {{/if}}
      </a>
      <address class="footer-address">
        {{#if @custom.footer_address}}
        {{{@custom.footer_address}}}
        {{else}}
        680 8th Main Road,<br>
        15th Cross, J.P. Nagar,<br>
        2nd Phase, Bengaluru,<br>
        560078
        {{/if}}
      </address>
    </div>

    {{!-- Navigation --}}
    <div class="footer-section footer-navigation">
      <h3 class="footer-title">Navigation</h3>
      <nav class="footer-nav" aria-label="Footer navigation">
        {{navigation type="primary"}}
      </nav>
    </div>

    {{!-- Connect --}}
    <div class="footer-section footer-social">
      <h3 class="footer-title">Connect with us!</h3>
      <div class="social-dock-wrapper">
        <div class="social-dock">
          <div class="social-dock-inner">

            {{#if @custom.footer_social_instagram}}
            {{!-- Instagram --}}
            <a href="{{@custom.footer_social_instagram}}" class="dock-item" aria-label="Instagram" target="_blank"
              rel="noopener noreferrer">
              <div class="dock-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                  aria-hidden="true">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
              </div>
              <span class="dock-label">Instagram</span>
            </a>
            {{/if}}

            {{#if @custom.footer_social_linkedin}}
            {{!-- LinkedIn --}}
            <a href="{{@custom.footer_social_linkedin}}" class="dock-item" aria-label="LinkedIn" target="_blank"
              rel="noopener noreferrer">
              <div class="dock-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                  aria-hidden="true">
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                  <rect x="2" y="9" width="4" height="12"></rect>
                  <circle cx="4" cy="4" r="2"></circle>
                </svg>
              </div>
              <span class="dock-label">LinkedIn</span>
            </a>
            {{/if}}

            {{#if @custom.footer_social_facebook}}
            {{!-- Facebook --}}
            <a href="{{@custom.footer_social_facebook}}" class="dock-item" aria-label="Facebook" target="_blank"
              rel="noopener noreferrer">
              <div class="dock-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                  aria-hidden="true">
                  <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                </svg>
              </div>
              <span class="dock-label">Facebook</span>
            </a>
            {{/if}}

          </div>
        </div>
      </div>
    </div>

  </div>

  {{!-- Footer Bottom --}}
  <div class="footer-bottom">
    <p>
      {{#if @custom.footer_copyright}}
      {{{@custom.footer_copyright}}}
      {{else}}
      &copy; {{date format="YYYY"}} {{@site.title}}. All rights reserved.
      {{/if}}
    </p>
  </div>
</footer>