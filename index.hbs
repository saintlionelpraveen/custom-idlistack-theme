{{!< default}}

<!-- ANIMATED BACKGROUND -->
<div class="animated-bg-wrapper">
  <div id="blur1" class="blur"></div>
  <div id="blur2" class="blur"></div>
  <div id="blur3" class="blur"></div>
</div>
{{!-- <a class="hero1"><img src="{{asset 'images/footer-logo.png'}}" alt="Hero Image"></a> --}}
<!-- HERO SECTION -->
<section id="hero-section" class="hero-section" aria-labelledby="hero-title" style="padding-left: 0; postion: relative;right: 100%;margin= 0;">
  <div class="hero-grid container">
    
    <!-- Left: Text Content -->
    <div class="hero-content" style="padding: 0;postion: relative;right: 100%;">
      <h1 id="title" class="title" style="font-weight: 400;font-size: 2rem;padding-top:0;position:relative;bottom:70px;">
        Open-source made effortless. Hosting made affordable.
        
      </h1>
      <p class="hero-description" style="font-size: medium;padding-top:0;position:relative;bottom:40px;">
        Because changemakers deserve <strong>Tech That Gives a Damn</strong>
      </p>

     <!-- JOIN BUTTON (replaced) -->
<a href="https://forms.gle/3gSeVYnXPisZAaqR7"
   class="btn-join-beta"
   aria-label="Join the Beta (Google Form)"
   target="_blank" rel="noopener" style="position:relative;bottom:20px;">
  <span class="btn-text">Join the Beta</span>
  <span class="neon-glow"></span>
</a>

      <br>
      <br>
      <p style="font-weight: 800;">Bring your heart. We’ve got the stack</p>
      
    </div>

    <!-- Right: Featured Image (No Card, Transparent BG) -->
    <figure class="hero-image-wrapper" aria-hidden="true" style="padding-top:0;position:relative;bottom:70px;">
      {{#if @site.cover_image}}
        <img 
          src="{{img_url @site.cover_image size="xl"}}" 
          alt="{{@site.title}} – Cover" 
          class="hero-image"
          loading="lazy"
          decoding="async"
        >
      {{else}}
        <img 
          src="{{asset 'images/hero-default.jpg'}}"
          alt="Hero Image"
          class="hero-image"
          loading="lazy"
          decoding="async"
        >
      {{/if}}
    </figure>

  </div>
</section>

<!-- POSTS SECTION – LEMON SQUEEZY STYLE -->
<section id="posts-section" class="posts-section container" aria-labelledby="posts-heading">
  <!-- Animated Background Blurs -->
  <div class="posts-section-bg">
    <div class="blur"></div>
    <div class="blur"></div>
    <div class="blur"></div>
  </div>

  {{!-- <h2 id="posts-heading" class="section-title">Latest Posts</h2> --}}

  <div class="posts-grid">
    {{#foreach posts}}
      <article class="post-card" data-post-id="{{id}}" data-slug="{{slug}}">

        <a href="{{url}}" class="post-link" aria-label="Read {{title}}">

          <!-- Fixed Size Container -->
          <div class="post-card-inner">
            <!-- ADDED: T4GC badge (rendered for all; CSS shows only for slug=fms) -->
            <div class="t4gc-badge" style="color: black;">T4GC <span class="heart" aria-hidden="true">❤️</span></div>

            <!-- Logo / Icon (Use Feature Image as Icon or Placeholder) -->
            <div class="post-logo">
              {{#if feature_image}}
                <img 
                  src="{{img_url feature_image size="s"}}" 
                  alt="{{title}} logo" 
                  class="post-icon"
                  loading="lazy"
                  decoding="async"
                >
              {{else}}
                <div class="post-icon-placeholder"></div>
              {{/if}}
            </div>

            <!-- Title -->
            <h3 class="post-title">{{title}}</h3>

            <!-- Excerpt (Description) -->
            <p class="post-excerpt">
              {{excerpt words="22"}}{{#unless excerpt}}This is a sample post description.{{/unless}}
            </p>

          </div>

          <!-- Neon Border -->
          <div class="neon-border"></div>
        </a>
      </article>
    {{else}}
      <!-- Empty State – Still Same Size -->
      <article class="post-card">
        <div class="post-card-inner">
          <div class="post-logo"><div class="post-icon-placeholder"></div></div>
          <h3 class="post-title">Sample Post</h3>
          <p class="post-excerpt">This is a placeholder post. Create content in Ghost admin.</p>
        </div>
      </article>
    {{/foreach}}
  </div>
</section>
{{!-- Replace slug:new-page with your page's slug --}}
{{#get "pages" filter="slug:new-page" limit="1"}}
  {{#foreach pages}}
    <section class="embedded-new-page">
      {{#if feature_image}}
        <img src="{{feature_image}}" alt="{{title}}">
        {{#if meta_description}}<p class="caption">{{meta_description}}</p>{{/if}}
      {{else}}
        {{{content}}}  {{!-- triple stash to render HTML from the page body --}}
      {{/if}}
    </section>
  {{/foreach}}
{{/get}}


{{!-- EMBED CIRCULAR GALLERY PAGE BY SLUG --}}
{{#get "pages" filter="slug:circle-gallery" limit="1"}}
  {{#foreach pages}}
    <div class="embedded-gallery">
      {{{content}}}
    </div>
  {{/foreach}}
{{/get}}

<!-- Load Animated Background Script -->
<script src="{{asset 'js/animated-background.js'}}"></script>