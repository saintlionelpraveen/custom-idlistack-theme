{{!< default}}

<div class="animated-bg-wrapper">
  <div id="blur1" class="blur"></div>
  <div id="blur2" class="blur"></div>
  <div id="blur3" class="blur"></div>
</div>

<section id="hero-section" class="hero-section" aria-labelledby="hero-title">
  <div class="hero-grid container">

    <div class="hero-content">
      <h1 id="title1" class="title1">
        Open-source made effortless. Hosting made affordable.
      </h1>
      <br>
      <p class="hero-description">
        Because changemakers deserve
        <br> <strong style="font-family: Bobby Jones;font-size:35px" class="damn">Tech That Gives a Damn</strong>
      </p>

      <a href="http://joinus.idlistack.com/beta"
         class="btn-join-beta"
         aria-label="Join the Beta (Google Form)"
         target="_blank" rel="noopener">
        <span class="btn-text">Join the Beta</span>
        <span class="neon-glow"></span>
      </a>

    
      <p class="hero-kicker" style="font-family:Bobby Jones;">Bring your heart. We’ve got the stack</p>
    </div>

    <figure class="hero-image-wrapper" aria-hidden="true">
      {{#if @site.cover_image}}
        <img 
          src="{{img_url @site.cover_image size="xl"}}"
          alt="{{@site.title}} – Cover"
          class="hero-image"
          loading="lazy"
          decoding="async"
        >
      {{else}}
        <img 
          src="{{asset 'images/hero-default.jpg'}}"
          alt="Hero Image"
          class="hero-image"
          loading="lazy"
          decoding="async"
        >
      {{/if}}
    </figure>

  </div>
</section>

<section id="posts-section" class="posts-section container" aria-labelledby="posts-heading">
  <div class="posts-section-bg">
    <div class="blur"></div><div class="blur"></div><div class="blur"></div>
  </div>

  <div class="posts-grid">
    {{#foreach posts}}
      <article class="post-card" data-post-id="{{id}}" data-slug="{{slug}}">
        <a href="{{url}}" class="post-link" aria-label="Read {{title}}">
          <div class="post-card-inner">
            <div class="t4gc-badge">❤️T4GC <span class="heart" aria-hidden="true" ></span></div>
            <div class="post-logo">
              {{#if feature_image}}
                <img src="{{img_url feature_image size="s"}}" alt="{{title}} logo" class="post-icon" loading="lazy" decoding="async">
              {{else}}
                <div class="post-icon-placeholder"></div>
              {{/if}}
            </div>
            <h3 class="post-title" style="font-size: larger;">{{title}}</h3>
            <br>
            <p class="post-excerpt">{{excerpt words="22"}}{{#unless excerpt}}This is a sample post description.{{/unless}}</p>
            <p class="arrow"id="arrow">»</p>
          </div>
          <div class="neon-border"></div>
        </a>
      </article>
    {{else}}
      <article class="post-card">
        <div class="post-card-inner">
          <div class="post-logo"><div class="post-icon-placeholder"></div></div>
          <h3 class="post-title">Sample Post</h3>
          <p class="post-excerpt">This is a placeholder post. Create content in Ghost admin.</p>
        </div>
      </article>
    {{/foreach}}
  </div>
</section>

{{#get "pages" filter="slug:new-page" limit="1"}}
  {{#foreach pages}}
    <section class="embedded-new-page">
      {{#if feature_image}}
        <img src="{{feature_image}}" alt="{{title}}">
        {{#if meta_description}}<p class="caption">{{meta_description}}</p>{{/if}}
      {{else}}
        {{{content}}}
      {{/if}}
    </section>
  {{/foreach}}
{{/get}}

{{#get "pages" filter="slug:circle-gallery" limit="1"}}
  {{#foreach pages}}
    <div class="embedded-gallery">
      {{{content}}}
    </div>
  {{/foreach}}
{{/get}}

<script src="{{asset 'js/animated-background.js'}}"></script>
