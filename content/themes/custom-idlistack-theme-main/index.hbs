{{!< default}} {{!-- Animated Background Blobs --}} <div class="animated-bg-wrapper" aria-hidden="true">
  <div id="blur1" class="blur"></div>
  <div id="blur2" class="blur"></div>
  <div id="blur3" class="blur"></div>
  </div>

  {{!-- ══════════════════════════════════════════════════
  HERO SECTION
  • Headline → Admin ▸ Design ▸ Site-wide ▸ "Hero headline"
  • Description → Admin ▸ Settings ▸ General ▸ "Site description"
  • Tagline → Admin ▸ Design ▸ Site-wide ▸ "Hero tagline"
  • CTA text+URL → Admin ▸ Design ▸ Site-wide
  • Cover image → Admin ▸ Settings ▸ Design ▸ "Publication cover"
  ══════════════════════════════════════════════════ --}}
  <section id="hero-section" class="hero-section" aria-labelledby="hero-title">
    <div class="hero-grid container">

      {{!-- LEFT: Copy --}}
      <div class="hero-content">

        {{!-- Big Headline (custom, NOT site name) --}}
        {{#if @custom.hero_headline}}
        <h1 id="hero-title" class="hero-title animate-fade-up animate-fade-up-2">
          {{@custom.hero_headline}}
        </h1>
        {{else}}
        {{!-- Fallback: show site title only if no custom headline set --}}
        <h1 id="hero-title" class="hero-title animate-fade-up animate-fade-up-2">
          {{@site.title}}
        </h1>
        {{/if}}

        {{!-- Subheading (Below Title) --}}
        {{#if @custom.hero_subheading}}
        <p class="hero-description animate-fade-up animate-fade-up-3">
          {{@custom.hero_subheading}}
        </p>
        {{/if}}

        {{!-- Bold Callout Tagline / Badge --}}
        {{#if @custom.hero_tagline}}
        <p class="hero-tagline animate-fade-up animate-fade-up-3">
          {{@custom.hero_tagline}}
        </p>
        {{/if}}

        {{!-- CTA Button --}}
        <div class="hero-actions animate-fade-up animate-fade-up-4">
          <a href="{{#if @custom.hero_cta_url}}{{@custom.hero_cta_url}}{{else}}/{{/if}}" class="btn-cta"
            aria-label="{{#if @custom.hero_cta_text}}{{@custom.hero_cta_text}}{{else}}Join the Beta{{/if}}" {{#if
            @custom.hero_button_bg_color}}style="--btn-bg: {{@custom.hero_button_bg_color}}; --btn-text: {{@custom.hero_button_text_color}}; --btn-hover: {{@custom.hero_button_hover_color}}; --btn-hover-text: {{@custom.hero_button_hover_text_color}};"
            {{/if}}>
            {{#if @custom.hero_cta_text}}{{@custom.hero_cta_text}}{{else}}Join the Beta{{/if}}
          </a>
        </div>

        {{!-- Extra Field 2 --}}
        {{#if @custom.hero_extra_field_2}}
        <p class="hero-extra-field animate-fade-up animate-fade-up-4" style="margin-top: 1rem;">
          {{@custom.hero_extra_field_2}}
        </p>
        {{/if}}


      </div>

      {{!-- RIGHT: Cover Image --}}
      <figure class="hero-image-wrapper animate-scale-in" aria-label="Hero image">
        {{#if @site.cover_image}}
        <img src="{{img_url @site.cover_image size=" xl"}}" alt="{{@site.title}}" class="hero-image" loading="eager"
          decoding="async" fetchpriority="high">
        {{else}}
        <div class="hero-image-placeholder">
          <div class="hero-image-placeholder-inner">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="3" width="18" height="18" rx="2" />
              <circle cx="8.5" cy="8.5" r="1.5" />
              <polyline points="21 15 16 10 5 21" />
            </svg>
            <p>Set a cover image in<br><strong>Admin → Design</strong></p>
          </div>
        </div>
        {{/if}}
      </figure>

    </div>
  </section>

  {{!-- ══════════════════════════════════════════════════
  SERVICES / POSTS SECTION
  Cards come from your Ghost posts. Section heading/label
  controlled by Admin ▸ Design ▸ Site-wide.
  ══════════════════════════════════════════════════ --}}
  <section id="posts-section" class="posts-section" aria-labelledby="posts-heading"
    style="{{#if @custom.posts_section_bg_color}}--posts-bg-color: {{@custom.posts_section_bg_color}};{{/if}}">

    <div class="posts-section-bg" aria-hidden="true">
      <svg class="blob-shape" viewBox="0 0 1440 600" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="blobGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#f9a8d4" stop-opacity="0.85" />
            <stop offset="50%" stop-color="#f472b6" stop-opacity="0.75" />
            <stop offset="100%" stop-color="#ec4899" stop-opacity="0.65" />
          </linearGradient>
        </defs>
        <path
          d="M 180 80 C 320 -20, 520 30, 600 120 C 680 210, 820 160, 960 200 C 1100 240, 1260 140, 1340 220 C 1420 300, 1380 460, 1260 500 C 1140 540, 980 480, 820 500 C 660 520, 500 560, 360 500 C 220 440, 100 520, 60 420 C 20 320, 40 180, 180 80 Z"
          fill="url(#blobGrad)" />
      </svg>
    </div>

    <div class="container">



      <div class="posts-grid" id="posts-grid-container">
        {{#get "posts" filter="tag:home" limit="100" include="tags"}}
        {{#foreach posts}}
        <article class="post-card reveal {{#has tag=" In-house, in-house"}}post-card-in-house{{/has}}"
          data-post-id="{{id}}" data-tags="{{#foreach tags}}{{name}},{{/foreach}}">
          <a href="{{url}}" class="post-link" aria-label="Read: {{title}}">
            {{#has tag="In-house, in-house"}}
            <div class="in-house-tooltip">T4GC</div>
            {{/has}}
            <div class="post-card-inner">
              <div class="post-logo">
                {{#if feature_image}}
                <img src="{{img_url feature_image size=" s"}}" alt="{{title}}" class="post-icon" loading="lazy">
                {{else}}
                <div class="post-icon-placeholder" aria-hidden="true"></div>
                {{/if}}
              </div>
              <h3 class="post-title">{{title}}</h3>
              <p class="post-excerpt">{{excerpt words="22"}}</p>
            </div>
            <div class="neon-border" aria-hidden="true"></div>
          </a>
        </article>
        {{else}}
        <article class="post-card">
          <div class="post-card-inner">
            <div class="post-logo">
              <div class="post-icon-placeholder"></div>
            </div>
            <h3 class="post-title">Create your first post</h3>
            <p class="post-excerpt">Add posts tagged with "home" in Ghost Admin to showcase them here.</p>
          </div>
        </article>
        {{/foreach}}
        {{/get}}
      </div>

    </div>
  </section>

  {{!-- ══════════════════════════════════════════════════
  WHY THE STACKS SECTION
  Full width image/GIF uploaded from Ghost Admin
  ══════════════════════════════════════════════════ --}}
  {{#if @custom.why_stacks_image}}
  <section class="why-stacks-section" aria-label="Why the Stacks">
    <img src="{{@custom.why_stacks_image}}" alt="Why the Stacks" class="why-stacks-image" loading="lazy">
  </section>
  {{/if}}

  {{!-- ══════════════════════════════════════════════════
  EARLY STACKERS ORBIT SECTION
  Pulls images from a Page tagged 'early-stackers'
  ══════════════════════════════════════════════════ --}}
  <div id="hidden-early-stackers-data" style="display: none;" aria-hidden="true">
    {{#get "pages" filter="tag:early-stackers" limit="1"}}
    {{#foreach pages}}
    {{{content}}}
    {{/foreach}}
    {{/get}}
  </div>

  <div id="early-stackers-mount" {{#if @custom.early_stackers_bg_color}}data-bg="{{@custom.early_stackers_bg_color}}"
    {{/if}}></div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const dataDiv = document.getElementById('hidden-early-stackers-data');
      const mount = document.getElementById('early-stackers-mount');

      if (dataDiv && mount) {
        const images = dataDiv.querySelectorAll('img');

        if (images.length > 0) {
          const totalItems = images.length;
          const title = "EARLY  STACKERS";

          let cardsHtml = '';

          images.forEach((img, index) => {
            let altText = "Impact Story";
            const figureNode = img.closest('figure');
            if (figureNode) {
              const figcaptionNode = figureNode.querySelector('figcaption');
              if (figcaptionNode) altText = figcaptionNode.innerText.trim();
            }

            cardsHtml += `
              <div class="stacker-avatar-wrapper" aria-label="Story about ${altText}" style="z-index: ${totalItems - index};">
                <img src="${img.src}" alt="${altText}" class="stacker-avatar" />
                <div class="stacker-tooltip">
                  ${altText}
                </div>
              </div>
            `;
          });

          // Define the basic flower SVG
          const flowerSVG = `
            <svg viewBox="0 0 100 250" class="flower-svg">
              <line x1="50" y1="50" x2="50" y2="250" stroke="#a3e635" stroke-width="2" stroke-opacity="0.6"/>
              <path d="M50 130 C30 130 20 110 20 110 C20 110 35 100 50 130" fill="#84cc16"/>
              <path d="M50 160 C70 160 80 140 80 140 C80 140 65 130 50 160" fill="#84cc16"/>
              
              <g class="flower-head">
                <circle cx="50" cy="20" r="14" fill="var(--petal)"/>
                <circle cx="73" cy="30" r="14" fill="var(--petal)"/>
                <circle cx="78" cy="55" r="14" fill="var(--petal)"/>
                <circle cx="63" cy="75" r="14" fill="var(--petal)"/>
                <circle cx="37" cy="75" r="14" fill="var(--petal)"/>
                <circle cx="22" cy="55" r="14" fill="var(--petal)"/>
                <circle cx="27" cy="30" r="14" fill="var(--petal)"/>
                <circle cx="50" cy="48" r="16" fill="var(--center)"/>
                <circle cx="50" cy="48" r="12" fill="none" stroke="#ffffff" stroke-dasharray="2,3" stroke-width="2" opacity="0.6"/>
                <circle cx="50" cy="48" r="5" fill="#ffffff" opacity="0.4"/>
              </g>
            </svg>
          `;

          mount.innerHTML = `
            <section class="early-stackers-section" aria-label="Early Stackers">
              <div class="stackers-container container">
                
                <h2 class="stackers-title">EARLY STACHERS</h2>

                <div class="avatars-row">
                  ${cardsHtml}
                </div>

                <div class="flowers-row">
                  <div class="flower-item" style="--petal: #fde047; --center: #ca8a04;">
                    <div class="flower-tooltip">Grow</div>
                    ${flowerSVG}
                  </div>
                  <div class="flower-item" style="--petal: #f9a8d4; --center: #f0abfc;">
                    <div class="flower-tooltip">Bloom</div>
                    ${flowerSVG}
                  </div>
                  <div class="flower-item" style="--petal: #3b82f6; --center: #facc15;">
                    <div class="flower-tooltip">Shine</div>
                    ${flowerSVG}
                  </div>
                  <div class="flower-item" style="--petal: #f43f5e; --center: #facc15;">
                    <div class="flower-tooltip">Thrive</div>
                    ${flowerSVG}
                  </div>
                  <div class="flower-item" style="--petal: #f97316; --center: #ea580c;">
                    <div class="flower-tooltip">Flourish</div>
                    ${flowerSVG}
                  </div>
                </div>

              </div>
            </section>
          `;
        }
      }
    });
  </script>